<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <Features>$(Features);runtime-async=on</Features>
        <IsAotCompatible>true</IsAotCompatible>
        <PublishAot>true</PublishAot>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <LangVersion>latest</LangVersion>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>true</AppendRuntimeIdentifierToOutputPath>
        <AssemblyName>Soenneker.Quark.Gen.Tailwind.Manifest.BuildTasks</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-rc.3.26522.148" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="11.0.0-rc.3.26522.148" />
        <PackageReference Include="Soenneker.Quark.Builders" Version="11.0.345" />
        <PackageReference Include="Soenneker.Utils.Directory" Version="11.0.970" />
        <PackageReference Include="Soenneker.Utils.File" Version="11.0.2328" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Soenneker.Extensions.ValueTask" Version="4.0.133" />
    </ItemGroup>
    <!-- Fluent chains reflect over the known builder library; preserve its callable members. -->
    <Target Name="PreserveQuarkBuilderAssemblies" BeforeTargets="ComputeIlcCompileInputs;PrepareForILLink" DependsOnTargets="ResolveReferences">
        <ItemGroup>
            <TrimmerRootAssembly Include="%(ReferencePath.Filename)" Condition="$([System.String]::Copy('%(ReferencePath.Filename)').StartsWith('Soenneker.Quark.'))" />
        </ItemGroup>
    </Target>
    <ItemGroup>
        <PackageReference Include="Soenneker.Utils.Json" Version="11.0.2769" />
    </ItemGroup>
</Project>
