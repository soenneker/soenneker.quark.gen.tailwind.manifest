<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <Target Name="QuarkTailwindManifestGeneratorBuild_Imported" BeforeTargets="Build">
        <Message Importance="high" Text="Soenneker.Quark.Gen.Tailwind.Manifest targets imported from: $(MSBuildThisFileFullPath)" />
    </Target>

    <PropertyGroup>
        <!-- Select the SDK host rather than the application's RuntimeIdentifier (for example browser-wasm). -->
        <QuarkTailwindManifestToolRuntimeIdentifier Condition="'$(QuarkTailwindManifestToolRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</QuarkTailwindManifestToolRuntimeIdentifier>
        <_QuarkTailwindManifestExecutableName>Soenneker.Quark.Gen.Tailwind.Manifest.BuildTasks</_QuarkTailwindManifestExecutableName>
        <_QuarkTailwindManifestExecutableName Condition="$([System.String]::Copy('$(QuarkTailwindManifestToolRuntimeIdentifier)').StartsWith('win-'))">$(_QuarkTailwindManifestExecutableName).exe</_QuarkTailwindManifestExecutableName>
        <_QuarkTailwindManifestNativePackagePath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/native/$(QuarkTailwindManifestToolRuntimeIdentifier)/$(_QuarkTailwindManifestExecutableName)'))</_QuarkTailwindManifestNativePackagePath>
        <_QuarkTailwindManifestNativeProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../artifacts/native/$(QuarkTailwindManifestToolRuntimeIdentifier)/$(_QuarkTailwindManifestExecutableName)'))</_QuarkTailwindManifestNativeProjectPath>
        <QuarkTailwindManifestBuildTasksExecutablePath Condition="'$(QuarkTailwindManifestBuildTasksExecutablePath)' == '' and Exists('$(_QuarkTailwindManifestNativePackagePath)')">$(_QuarkTailwindManifestNativePackagePath)</QuarkTailwindManifestBuildTasksExecutablePath>
        <QuarkTailwindManifestBuildTasksExecutablePath Condition="'$(QuarkTailwindManifestBuildTasksExecutablePath)' == ''">$(_QuarkTailwindManifestNativeProjectPath)</QuarkTailwindManifestBuildTasksExecutablePath>

        <!-- Package-scoped names so multiple Soenneker.Quark.Gen.* packages can coexist in one project. -->
        <QuarkTailwindManifestGeneratorBuildEnabled Condition="'$(QuarkTailwindManifestGeneratorBuildEnabled)'==''">true</QuarkTailwindManifestGeneratorBuildEnabled>
        <_QuarkTailwindManifestProjectDir>$([System.IO.Path]::GetDirectoryName('$(ProjectDir)x'))</_QuarkTailwindManifestProjectDir>
        <_QuarkTailwindManifestProjectDir Condition="'$(_QuarkTailwindManifestProjectDir)' == ''">$(MSBuildProjectDirectory)</_QuarkTailwindManifestProjectDir>
        <QuarkTailwindManifestOutput Condition="'$(QuarkTailwindManifestOutput)' == ''">$([System.IO.Path]::Combine('$(_QuarkTailwindManifestProjectDir)', 'tailwind', 'quark-tailwind-manifest.txt'))</QuarkTailwindManifestOutput>
        <_QuarkTailwindManifestOutputArg Condition="'$(QuarkTailwindManifestOutput)' != ''"> --manifestOutput &quot;$(QuarkTailwindManifestOutput)&quot;</_QuarkTailwindManifestOutputArg>
        <_QuarkTailwindManifestStamp>$([System.IO.Path]::Combine('$(MSBuildProjectExtensionsPath)', '$(Configuration)', '$(TargetFramework)', 'quark-tailwind-manifest-generator.stamp'))</_QuarkTailwindManifestStamp>
    </PropertyGroup>

    <ItemGroup>
        <_QuarkTailwindManifestInputs Include="$(_QuarkTailwindManifestProjectDir)\**\*.cs;$(_QuarkTailwindManifestProjectDir)\**\*.razor"
                                      Exclude="$(_QuarkTailwindManifestProjectDir)\bin\**;$(_QuarkTailwindManifestProjectDir)\obj\**;$(_QuarkTailwindManifestProjectDir)\tailwind\**;$(_QuarkTailwindManifestProjectDir)\node_modules\**" />
    </ItemGroup>

    <Target Name="RunQuarkTailwindManifestGeneratorBuildTasks"
            BeforeTargets="Build"
            Inputs="@(_QuarkTailwindManifestInputs);$(MSBuildProjectFullPath);$(ProjectAssetsFile);$(QuarkTailwindManifestBuildTasksExecutablePath)"
            Outputs="$(QuarkTailwindManifestOutput);$(_QuarkTailwindManifestStamp)"
            Condition="'$(DesignTimeBuild)'!='true' and '$(IsCrossTargetingBuild)'!='true' and '$(QuarkTailwindManifestGeneratorBuildEnabled)'=='true'">

        <Message Importance="high" Text="Running Soenneker.Quark.Gen.Tailwind.Manifest BuildTasks: projectDir=$(_QuarkTailwindManifestProjectDir) output=$(QuarkTailwindManifestOutput)" />
        <Error Condition="'$(_QuarkTailwindManifestProjectDir)' == ''"
               Text="Soenneker.Quark.Gen.Tailwind.Manifest: project directory could not be resolved (ProjectDir and MSBuildProjectDirectory are empty)." />
        <Error Condition="'$(QuarkTailwindManifestBuildTasksExecutablePath)'==''"
               Text="QuarkTailwindManifestBuildTasksExecutablePath was not resolved. MSBuildThisFileDirectory=$(MSBuildThisFileDirectory)" />
        <Error Condition="!Exists('$(QuarkTailwindManifestBuildTasksExecutablePath)')"
               Text="Tailwind.Manifest native BuildTasks executable not found at '$(QuarkTailwindManifestBuildTasksExecutablePath)'." />

        <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_QuarkTailwindManifestStamp)'))" />
        <!-- NuGet extraction does not preserve Unix execute permissions. -->
        <Exec Condition="'$(OS)' != 'Windows_NT'" Command="chmod +x &quot;$(QuarkTailwindManifestBuildTasksExecutablePath)&quot;" />
        <Exec WorkingDirectory="$(_QuarkTailwindManifestProjectDir)"
              IgnoreExitCode="false"
              ConsoleToMSBuild="true"
              StandardOutputImportance="high"
              StandardErrorImportance="high"
              Command='&quot;$(QuarkTailwindManifestBuildTasksExecutablePath)&quot; --projectDir &quot;$(_QuarkTailwindManifestProjectDir)&quot;$(_QuarkTailwindManifestOutputArg)' />
        <Touch Files="$(QuarkTailwindManifestOutput);$(_QuarkTailwindManifestStamp)" AlwaysCreate="true" />
    </Target>
</Project>
