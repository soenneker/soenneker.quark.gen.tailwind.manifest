<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591;</NoWarn>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <DevelopmentDependency>true</DevelopmentDependency>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddBuildTasksOutputToPackage</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <PropertyGroup>
        <Description>A generator that builds a manifest of tailwind usage in a project</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">4.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.Quark.Gen.Tailwind.Manifest</AssemblyName>
        <PackageId>Soenneker.Quark.Gen.Tailwind.Manifest</PackageId>
        <PackageTags>quark gen tailwind manifest classes source generator quarktailwindmanifestgenerator externalgenerator csharp dotnet c# .net</PackageTags>
        <Copyright>Copyright © 2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/soenneker/soenneker.quark.gen.tailwind.manifest</PackageProjectUrl>
        <RepositoryUrl>https://github.com/soenneker/soenneker.quark.gen.tailwind.manifest</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <None Include="Soenneker.Quark.Gen.Tailwind.Manifest.targets" Pack="true" PackagePath="build\" />
        <None Include="Soenneker.Quark.Gen.Tailwind.Manifest.targets" Pack="true" PackagePath="buildTransitive\" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(TargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <None Include="$(TargetDir)$(AssemblyName).pdb" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
    </ItemGroup>
    <PropertyGroup>
        <QuarkTailwindManifestNativeRuntimeIdentifier Condition="'$(QuarkTailwindManifestNativeRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</QuarkTailwindManifestNativeRuntimeIdentifier>
        <QuarkTailwindManifestNativeArtifactsDir Condition="'$(QuarkTailwindManifestNativeArtifactsDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../artifacts/native'))</QuarkTailwindManifestNativeArtifactsDir>
        <_QuarkTailwindManifestNativeExecutable>Soenneker.Quark.Gen.Tailwind.Manifest.BuildTasks</_QuarkTailwindManifestNativeExecutable>
        <_QuarkTailwindManifestNativeExecutable Condition="$([System.String]::Copy('$(QuarkTailwindManifestNativeRuntimeIdentifier)').StartsWith('win-'))">$(_QuarkTailwindManifestNativeExecutable).exe</_QuarkTailwindManifestNativeExecutable>
    </PropertyGroup>

    <Target Name="BuildBuildTasksTool" BeforeTargets="Build"
            Condition="'$(QuarkTailwindManifestUsePrebuiltNativeTools)' != 'true'"
            Inputs="@(QuarkTailwindManifestNativeSource);../Soenneker.Quark.Gen.Tailwind.Manifest.BuildTasks/obj/project.assets.json"
            Outputs="$(QuarkTailwindManifestNativeArtifactsDir)/$(QuarkTailwindManifestNativeRuntimeIdentifier)/$(_QuarkTailwindManifestNativeExecutable)">
        <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)/../Soenneker.Quark.Gen.Tailwind.Manifest.BuildTasks/Soenneker.Quark.Gen.Tailwind.Manifest.BuildTasks.csproj&quot; --configuration Release --runtime $(QuarkTailwindManifestNativeRuntimeIdentifier) --output &quot;$(QuarkTailwindManifestNativeArtifactsDir)/$(QuarkTailwindManifestNativeRuntimeIdentifier)&quot;" />
    </Target>

    <ItemGroup>
        <QuarkTailwindManifestNativeSource Include="../Soenneker.Quark.Gen.Tailwind.Manifest.BuildTasks/**/*.cs;../Soenneker.Quark.Gen.Tailwind.Manifest.BuildTasks/*.csproj"
                             Exclude="../Soenneker.Quark.Gen.Tailwind.Manifest.BuildTasks/bin/**;../Soenneker.Quark.Gen.Tailwind.Manifest.BuildTasks/obj/**" />
    </ItemGroup>

    <Target Name="AddBuildTasksOutputToPackage" DependsOnTargets="BuildBuildTasksTool">
        <ItemGroup>
            <_QuarkTailwindManifestRequiredRuntime Include="win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64" Condition="'$(QuarkTailwindManifestUsePrebuiltNativeTools)' == 'true'" />
            <_QuarkTailwindManifestNativeFile Include="$(QuarkTailwindManifestNativeArtifactsDir)/**/*"
                                Exclude="$(QuarkTailwindManifestNativeArtifactsDir)/**/*.pdb;$(QuarkTailwindManifestNativeArtifactsDir)/**/*.dbg;$(QuarkTailwindManifestNativeArtifactsDir)/**/*.dSYM/**" />
            <TfmSpecificPackageFile Include="@(_QuarkTailwindManifestNativeFile)" PackagePath="tools/native/" />
        </ItemGroup>
        <Error Condition="'@(_QuarkTailwindManifestRequiredRuntime)' != '' and !Exists('$(QuarkTailwindManifestNativeArtifactsDir)/%(_QuarkTailwindManifestRequiredRuntime.Identity)/Soenneker.Quark.Gen.Tailwind.Manifest.BuildTasks') and !Exists('$(QuarkTailwindManifestNativeArtifactsDir)/%(_QuarkTailwindManifestRequiredRuntime.Identity)/Soenneker.Quark.Gen.Tailwind.Manifest.BuildTasks.exe')"
               Text="Missing native tailwind.manifest tool for %(_QuarkTailwindManifestRequiredRuntime.Identity)." />
        <Error Condition="'@(_QuarkTailwindManifestNativeFile)' == ''" Text="Native tailwind.manifest tools are missing. Publish BuildTasks before packing." />
    </Target>
</Project>
